// Optional preservation of the former collector. Promtail is the default collector.
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}
discovery.relabel "portfolio" {
  targets = discovery.docker.local.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = "portfolio-manh"
    action = "keep"
  }
  rule {
    target_label = "job"
    replacement = "legacy-docker"
  }
}
loki.source.docker "local" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.portfolio.output
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

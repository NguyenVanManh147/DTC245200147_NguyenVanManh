{
  "uid": "portfolio-infrastructure",
  "title": "Portfolio • Container / Nginx / MySQL",
  "tags": [
    "portfolio",
    "DTC245200147"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Ho_Chi_Minh",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"

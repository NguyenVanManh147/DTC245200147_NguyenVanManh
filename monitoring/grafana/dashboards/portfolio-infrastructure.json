  "panels": [
    {
      "id": 1,
      "title": "Container CPU theo dịch vụ",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "portfolio-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=\"portfolio-manh\"}[2m])) * 100",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "portfolio-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {

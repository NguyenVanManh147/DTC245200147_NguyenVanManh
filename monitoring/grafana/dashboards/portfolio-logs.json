      "title": "HTTP 4xx / 5xx",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "portfolio-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"portfolio-manh\",job=\"nginx-access\"} | json | __error__=\"\" | status >= 400 | status < 600",

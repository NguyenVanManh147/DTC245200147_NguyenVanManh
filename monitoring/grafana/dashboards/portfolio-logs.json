            "type": "loki",
            "uid": "portfolio-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Requests trong từng cửa sổ 1 phút",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "portfolio-loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
